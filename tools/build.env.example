# Copy to tools/build.env, which is gitignored, and fill in your own machines.
# tools/build.sh sources it.

# A machine with the .NET 9 SDK, reachable over ssh with key auth. The build is
# delegated because the dev Mac is too old for any supported SDK.
BUILD_HOST=user@build-machine

# The machine running Jellyfin. Only needed for --deploy.
JELLYFIN_HOST=user@jellyfin-server

# Optional, these defaults usually do.
#BUILD_DIR='~/build/heic-for-jelly'
#JELLYFIN_PLUGINS='~/Documents/jellyfin/config/plugins'
